# ============ انسخ هذا الملف إلى .env ثم عبّئ القيم ============
# الأمر:  cp .env.example .env && nano .env && chmod 600 .env
# لا ترفع ملف .env إلى أي مكان ولا ترسله لأحد.
# ملاحظة: التعليقات في أسطر مستقلة فقط (لا تكتب تعليقاً بعد القيمة في السطر نفسه).

# --- Binance ---
# ضع هنا مفاتيح حساب Demo (من demo.binance.com) وفعّل لها صلاحية Futures إن استخدمت الفيوتشرز
BINANCE_API_KEY=PUT_API_KEY_HERE
BINANCE_SECRET_KEY=PUT_SECRET_HERE
# القيم الممكنة: demo | testnet | live (أبقِها demo)
BINANCE_ENV=demo

# --- تيليجرام ---
TELEGRAM_BOT_TOKEN=PUT_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=PUT_CHAT_ID_HERE

# --- السوق والعملات ---
# spot (موصى به) أو futures (عقود دائمة للعملات الرقمية)
MARKET_TYPE=spot
# قائمة العملات، افصل بفاصلة. يمكنك كتابتها هكذا BTC/USDT أو هكذا BTCUSDT
# العملات غير الموجودة في Demo يتجاهلها البوت ويخبرك في اللوج
SYMBOLS=BTC/USDT,ETH/USDT,BNB/USDT,SOL/USDT,XRP/USDT,ADA/USDT
# قيمة كل صفقة بالدولار
TRADE_AMOUNT_USDT=300
# أقصى عدد صفقات مفتوحة في نفس الوقت عبر كل العملات
MAX_OPEN_POSITIONS=3
# الرافعة للفيوتشرز فقط (تُهمل في السبوت)
LEVERAGE=1
MARGIN_MODE=isolated

# --- الاستراتيجية ---
TIMEFRAME=15m
EMA_PERIOD=20
RSI_MAX_ENTRY=70
REQUIRE_MACD=true

# --- تنفيذ الأوامر ---
# false = محاكاة فقط بدون إرسال أوامر
TRADING_ENABLED=true
# صفقة اختبار واحدة عند كل تشغيل (اتركها false)
FORCE_TEST_TRADE=false

# --- فلتر الأخبار (Groq) ---
NEWS_FILTER=true
GROQ_API_KEY=PUT_GROQ_KEY_HERE
NEWS_BLOCK_SEVERITY=4
NEWS_PAUSE_HOURS=3

# --- لوحة التحكم ---
# شكل اللوحة: lime (فسفورية ليمونية) أو neon (بنفسجية متوهجة)
DASHBOARD_THEME=lime
# 127.0.0.1 = من السيرفر فقط عبر نفق SSH (الأكثر أماناً). 0.0.0.0 = من الإنترنت (يلزمها كلمة مرور)
DASHBOARD_BIND=127.0.0.1
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
# المنطقة الزمنية للسجلات وحساب "اليوم"
TZ=Asia/Riyadh
